# WinterRoad - Environment Configuration Example
# Copy this file to .env and set your credentials. Never commit .env to version control!

# Server & Database Settings
PORT=8000
HOST=0.0.0.0
DB_PATH=backend/data/reports.db
UPLOAD_DIR=backend/data/uploads

# Admin Authentication
# Demo default username: admin
ADMIN_USERNAME=admin

# Admin Password Configuration:
# Option A: Set plaintext password (will be automatically hashed on startup)
ADMIN_PASSWORD=your_secure_admin_password_here

# Option B (Recommended): Set precomputed PBKDF2 or SHA-256 hash
# ADMIN_PASSWORD_HASH=your_precomputed_password_hash_here

# Session Security Secret
SESSION_SECRET_KEY=change-this-to-a-secure-random-string-for-production
